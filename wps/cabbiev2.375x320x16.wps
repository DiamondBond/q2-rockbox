# Cabbie v2.0
# (C) 2007-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "cabbie" (C) Yohann Misquitta
#
# The 400x240 layout for the Shanling Q2, kept clear of the glass's rounded
# corners (about 80 px radius). No hold switch, so no hold icon.
#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(backdrop-375x320x16.bmp)
#
# Header font
%Fl(2,14-Adobe-Helvetica-Bold.fnt)
#
# Preload Images
%xl(B,battery-320x240x16.bmp,0,0,10)
%xl(C,volume-320x240x16.bmp,0,0,10)
%xl(D,shuffle-320x240x16.bmp,0,0)
%xl(E,repeat-320x240x16.bmp,0,0,4)
%xl(F,playmode-320x240x16.bmp,0,0,5)
%xl(G,shuffleoff-400x240x16.bmp,0,0)
%xl(H,repeatoff-400x240x16.bmp,0,0)
#
# Album Art/Info Viewport Conditional
%?C<%Vd(a)|%Vd(b)>
#
# Header
%V(52,11,272,14,2)%Vf(0F0B00)
%acNOW PLAYING
#
# Progress Bar
%V(16,204,343,15,-)
%pb(0,0,343,15,pb-375x320x16.bmp)
#
# Battery
%V(94,262,44,23,-)
%?bp<%?bc<%xd(Ba)|%xd(Bb)>|%?bl<|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)>>
#
# Volume
%V(145,262,34,23,-)
%?pv<%xd(Ca)|%xd(Cb)|%xd(Cc)|%xd(Cd)|%xd(Ce)|%xd(Cf)|%xd(Cg)|%xd(Ch)|%xd(Ci)|%xd(Cj)>
#
# Shuffle
%V(189,266,37,16,-)
%?ps<%xd(D)|%xd(G)>
#
# Repeat
%V(232,262,18,23,-)
%?mm<%xd(H)|%xd(Ea)|%xd(Eb)|%xd(Ec)|%xd(Ed)>
#
# Playmode
%V(258,262,24,23,-)
%?mp<%xd(Fa)|%xd(Fb)|%xd(Fc)|%xd(Fd)|%xd(Fe)>
#
# Time Elapsed/Remaining
%V(32,224,311,22,1)
%al%pc%ac%?Sr<%pe %Sx(of) %pp|%pp %Sx(of) %pe>%ar%pr
#
# Album Art
%ax%Vl(a,20,40,150,150,-)
%Cl(0,0,150,150,c,c)
%Cd
#
# Track Info - Album Art
%ax%Vl(a,184,40,175,152,1)
%s%al%?id<%id|%?d(1)<%d(1)|%(root%)>>
%s%al%?it<%it|%fn>
%s%al%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|%(root%)>>>
%s%al%?iy<%iy>

%s%al%Sx(Next Track:)
%s%al%?It<%It|%Fn>
%s%al%?Ia<%Ia|%?IA<%IA>>
#
# Track Info - No Album Art
%ax%Vl(b,16,40,343,152,1)
%s%ac%?id<%id|%?d(1)<%d(1)|%(root%)>>
%s%ac%?it<%it|%fn>
%s%ac%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|%(root%)>>>
%s%ac%?iy<%iy>

%ac%Sx(Next Track:)
%s%ac%?It<%It|%Fn>
%s%ac%?Ia<%Ia|%?IA<%IA>>
